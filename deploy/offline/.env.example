# Copy this file to .env before deployment and replace both CHANGE_ME values.
COMPOSE_PROJECT_NAME=mywebserver-v5
PUBLIC_PORT=8080
MYSQL_CONTAINER_NAME=mywebserver-v5-mysql
REDIS_CONTAINER_NAME=mywebserver-v5-redis
APP_CONTAINER_NAME=mywebserver-v5-app
NGINX_CONTAINER_NAME=mywebserver-v5-nginx
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=my_web_server
MYSQL_USER=webuser
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

# New v5 deployment defaults. To reuse v2 data, replace each name with the
# exact value reported by docker inspect and set the matching EXTERNAL to true.
MYSQL_VOLUME_NAME=mywebserver-v5_mysql_data
MYSQL_VOLUME_EXTERNAL=false
REDIS_VOLUME_NAME=mywebserver-v5_redis_data
REDIS_VOLUME_EXTERNAL=false
IMAGE_VOLUME_NAME=mywebserver-v5_image_data
IMAGE_VOLUME_EXTERNAL=false

# Capacity and timeout defaults. Adjust only after observing /metrics and p99.
MYSQL_POOL_SIZE=8
MYSQL_POOL_WAIT_TIMEOUT_MS=100
REDIS_POOL_SIZE=8
REDIS_KEY_PREFIX=myweb:v5:
REDIS_IO_TIMEOUT_MS=3000
REDIS_COMMAND_CAPACITY=4096
REDIS_MAX_PIPELINE_PER_CONNECTION=256
SESSION_TTL_SECONDS=86400
SESSION_CACHE_TTL_SECONDS=3
SESSION_CACHE_CAPACITY=20000
LOGIN_CACHE_TTL_SECONDS=3
LOGIN_CACHE_CAPACITY=10000
WORKER_QUEUE_CAPACITY=4096
LOG_QUEUE_CAPACITY=8192
COMPLETION_QUEUE_CAPACITY=4096
PENDING_CONNECTION_QUEUE_CAPACITY=1024
MAX_CONNECTIONS_PER_SUB_REACTOR=4096
LISTEN_BACKLOG=1024
CONNECTION_IDLE_TIMEOUT_MS=60000
BUSINESS_TIMEOUT_MS=15000
MAX_IMAGES_PER_USER=100
MAX_CONCURRENT_UPLOADS_PER_USER=2
UPLOAD_RATE_LIMIT_PER_MINUTE=20
UPLOAD_PERMIT_TTL_SECONDS=30
UPLOAD_IDEMPOTENCY_TTL_SECONDS=86400
IMAGE_LIFECYCLE_PENDING_TTL_SECONDS=120
IMAGE_LIST_CACHE_TTL_SECONDS=3
IMAGE_STATUS_CACHE_TTL_SECONDS=30
IMAGE_PROCESSOR_THREADS=2
IMAGE_PROCESSOR_QUEUE_CAPACITY=256
IMAGE_PROCESSOR_TIMEOUT_SECONDS=15
THUMBNAIL_MAX_WIDTH=480
THUMBNAIL_MAX_HEIGHT=480
THUMBNAIL_WEBP_QUALITY=82
MYWEBSERVER_LOG_LEVEL=WARN
